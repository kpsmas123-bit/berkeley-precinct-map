.venv/
__pycache__/
*.pyc
.DS_Store

# large, reproducible via ingest/download.sh
data/raw/

# county build scratch (full pre-filter parse; regenerated by build_county.sh)
data/processed/county/tmp/
# cached upstream registration downloads (re-fetched on demand)
data/raw/registration/

# Build intermediates. site/data/ is the published copy and is tracked; these are
# regenerated by ./build.sh and ./build_county.sh, so committing both kept the same
# bytes in git twice and made every rebuild a few hundred blob diffs.
data/processed/results/
data/processed/geo/
data/processed/county/
data/processed/live/
data/processed/registration/
data/processed/measures.json
data/processed/crosswalk.json
data/processed/history.json
